{
  "name": "records-chat",
  "displayName": "Records Chat",
  "description": "Chat-style editor for the records site — mechanical skills without AI (or with Ollama).",
  "version": "0.2.0",
  "publisher": "tb4",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/tb4/records.git",
    "directory": "others/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "records",
          "title": "Records",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "records": [
        {
          "type": "webview",
          "id": "recordsChat",
          "name": "Chat",
          "contextualTitle": "Records Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "records.openChat",
        "title": "Records: Open Chat"
      }
    ],
    "keybindings": [
      {
        "command": "records.openChat",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Records",
      "properties": {
        "records.binaryPath": {
          "type": "string",
          "default": "records",
          "description": "Path to the recordkit CLI (records command)."
        },
        "records.ollamaEndpoint": {
          "type": "string",
          "default": "",
          "description": "Optional: Ollama endpoint URL (e.g., http://localhost:11434) to enable two-sided /record and voice skills."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
