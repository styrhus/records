{
    "_comment": "Skylighting theme matching the site's light --hl-* palette (Tokyo Night Light) in baseof.html; the pre background comes from pdf.css --surface.",
    "text-color": null,
    "background-color": null,
    "line-number-color": "#757985",
    "line-number-background-color": null,
    "text-styles": {
        "Comment": { "text-color": "#757985", "italic": true },
        "Documentation": { "text-color": "#757985", "italic": true },
        "Annotation": { "text-color": "#757985", "italic": true },
        "CommentVar": { "text-color": "#757985", "italic": true },
        "Information": { "text-color": "#757985", "italic": true },
        "Preprocessor": { "text-color": "#757985", "italic": true },
        "Keyword": { "text-color": "#523881" },
        "ControlFlow": { "text-color": "#523881" },
        "Operator": { "text-color": "#523881" },
        "Constant": { "text-color": "#523881" },
        "Import": { "text-color": "#523881" },
        "String": { "text-color": "#2f4f0b" },
        "Char": { "text-color": "#2f4f0b" },
        "SpecialChar": { "text-color": "#2f4f0b" },
        "VerbatimString": { "text-color": "#2f4f0b" },
        "SpecialString": { "text-color": "#2f4f0b" },
        "DecVal": { "text-color": "#6c391c" },
        "BaseN": { "text-color": "#6c391c" },
        "Float": { "text-color": "#6c391c" },
        "Function": { "text-color": "#204584" },
        "BuiltIn": { "text-color": "#0f4b6e" },
        "DataType": { "text-color": "#0f4b6e" },
        "Extension": { "text-color": "#0f4b6e" },
        "Variable": { "text-color": "#6e3540" },
        "Attribute": { "text-color": "#6e3540" },
        "Warning": { "text-color": "#6e3540" },
        "Alert": { "text-color": "#6e3540" },
        "Error": { "text-color": "#6e3540" }
    }
}
