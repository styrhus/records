{
    "_comment": "Skylighting theme matching the site's light --hl-* palette (Tokyo Night Light) in baseof.html; the pre background comes from pdf.css --surface.",
    "text-color": null,
    "background-color": null,
    "line-number-color": "#9699a3",
    "line-number-background-color": null,
    "text-styles": {
        "Comment": { "text-color": "#9699a3", "italic": true },
        "Documentation": { "text-color": "#9699a3", "italic": true },
        "Annotation": { "text-color": "#9699a3", "italic": true },
        "CommentVar": { "text-color": "#9699a3", "italic": true },
        "Information": { "text-color": "#9699a3", "italic": true },
        "Preprocessor": { "text-color": "#9699a3", "italic": true },
        "Keyword": { "text-color": "#5a3e8e" },
        "ControlFlow": { "text-color": "#5a3e8e" },
        "Operator": { "text-color": "#5a3e8e" },
        "Constant": { "text-color": "#5a3e8e" },
        "Import": { "text-color": "#5a3e8e" },
        "String": { "text-color": "#385f0d" },
        "Char": { "text-color": "#385f0d" },
        "SpecialChar": { "text-color": "#385f0d" },
        "VerbatimString": { "text-color": "#385f0d" },
        "SpecialString": { "text-color": "#385f0d" },
        "DecVal": { "text-color": "#965027" },
        "BaseN": { "text-color": "#965027" },
        "Float": { "text-color": "#965027" },
        "Function": { "text-color": "#2959aa" },
        "BuiltIn": { "text-color": "#0f4b6e" },
        "DataType": { "text-color": "#0f4b6e" },
        "Extension": { "text-color": "#0f4b6e" },
        "Variable": { "text-color": "#8c4351" },
        "Attribute": { "text-color": "#8c4351" },
        "Warning": { "text-color": "#8c4351" },
        "Alert": { "text-color": "#8c4351" },
        "Error": { "text-color": "#8c4351" }
    }
}
